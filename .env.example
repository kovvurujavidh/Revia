# Importers/Callers: Next.js environment configuration, Vercel deployment, GitHub repository setup
# Affected API: Supabase Client, Auth Handlers, Admin Server API
# Data Schemas: Environment variables
# User's Verbatim Instruction: "KEEPENV IN THE GIT HUB SO IT CAN AUTO DETECT AND BEFORE PUSH CHECK EVERTHING AND MAIN CONCEPT IS WORKING OR NOT"

# Supabase Configuration (Get from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Required for server-side auth & admin routes)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
